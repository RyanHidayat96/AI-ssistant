local.properties
.gradle/
.idea/
*.iml
.vscode/
captures/

# Logs and temporary files
*.log
*.tmp
*.swp
*.bak
*~
.DS_Store
Thumbs.db

# Python bytecode from helper scripts
__pycache__/
*.py[cod]
